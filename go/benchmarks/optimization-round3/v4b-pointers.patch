+// reserveWorkingDicePointers reserves only a bounded initial prefix. Each call
+// owns its index array; local modifier pools must not share the roll's index
+// because explosions append to both. Reservation never consumes a budget.
+func reserveWorkingDicePointers(quantity int64, budget *ExecutionBudget) []*workingDie {
+	// One append already allocates exactly once; no reservation is needed.
+	if quantity <= 1 {
+		return []*workingDie{}
+	}
+	capacity := max(int64(0), min(quantity, 256,
+		budget.limits.MaxInitialDice-budget.snapshot.InitialDice,
+		budget.limits.MaxResultItems-budget.snapshot.ResultItems))
+	return make([]*workingDie, 0, capacity)
+}
