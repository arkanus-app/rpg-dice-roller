  "variants": [
    {
      "id": 1,
      "hypothesis": "Copy the invariant MT init_by_array precursor state instead of recalculating it",
      "accepted": true
    },
    {
      "id": 2,
      "hypothesis": "Split in-place MT twist wraparound boundaries to remove remainder operations and branch on parity",
      "accepted": true
    },
    {
      "id": 3,
      "hypothesis": "Hash canonical UTF-16 directly without allocating temporary rune/code-unit slices",
      "accepted": true
    },
    {
      "id": 4,
      "hypothesis": "Decode 128-bit replay seed material into a fixed-size stack buffer",
      "accepted": true
    }
  ],
