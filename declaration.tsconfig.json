{
  "extends": "./tsconfig",
  "include": [
    "src/index.ts",
    "src/v3/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "dist",
    "node_modules"
  ],
  "compilerOptions": {
    "declaration": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "dist"
  }
}
