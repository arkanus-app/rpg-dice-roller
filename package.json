{
  "name": "@erpg/dicecore",
  "description": "ERPG dice core with ergonomic RPG notation, grouped rolls, structured UI data, deterministic replay, and safe parse-only inspection.",
  "author": "Arkanus",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/arkanus-app/rpg-dice-roller.git"
  },
  "bugs": {
    "url": "https://github.com/arkanus-app/rpg-dice-roller/issues"
  },
  "homepage": "https://github.com/arkanus-app/rpg-dice-roller",
  "keywords": [
    "dice",
    "roller",
    "rpg",
    "roll",
    "d&d",
    "dnd",
    "random",
    "prng",
    "roleplay",
    "pathfinder",
    "notation"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.3",
    "@babel/preset-typescript": "^7.28.5",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "peggy": "^5.1.0",
    "rollup": "^4.60.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "random-js": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0"
  },
  "scripts": {
    "build": "npm run build:prepare && npm run build:bundle && npm run build:declaration",
    "build:prepare": "npm run build:grammars && npm run lint",
    "build:declaration": "node ./scripts/build-declarations.cjs",
    "build:bundle": "rollup --config",
    "build:grammars": "peggy -c ./peggy.config.cjs ./src/parser/grammars/grammar.pegjs",
    "benchmark": "node ./scripts/benchmark.mjs",
    "watch": "rollup --config --watch",
    "lint": "eslint \"src/**/*.{js,ts}\" \"tests/**/*.{js,ts}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,ts}\" \"tests/**/*.{js,ts}\"",
    "pretest": "npm run build:prepare",
    "test": "jest",
    "test:coverage": "npm test -- --coverage",
    "test:watch": "npm test -- --watchAll",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run build"
  }
}
