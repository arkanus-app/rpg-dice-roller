{
  "name": "@dice-roller/rpg-dice-roller",
  "description": "Arkanus proprietary RPG dice roller with ergonomic RPG notation, grouped rolls, structured UI data, and deterministic replay support.",
  "author": "Arkanus",
  "version": "5.5.3",
  "license": "MIT",
  "type": "module",
  "main": "./lib/esm/bundle.js",
  "module": "./lib/esm/bundle.js",
  "browser": "./lib/umd/bundle.js",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./lib/esm/bundle.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./lib/umd/bundle.js"
      }
    },
    "./lib/umd/bundle.js": {
      "types": "./types/index.d.cts",
      "require": "./lib/umd/bundle.js"
    },
    "./src/": "./src/",
    "./types/": "./types/",
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/arkanus-app/rpg-dice-roller.git"
  },
  "bugs": {
    "url": "https://github.com/arkanus-app/rpg-dice-roller/issues"
  },
  "homepage": "https://github.com/arkanus-app/rpg-dice-roller",
  "keywords": [
    "dice",
    "roller",
    "rpg",
    "roll",
    "d&d",
    "dnd",
    "random",
    "prng",
    "roleplay",
    "pathfinder",
    "notation"
  ],
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@babel/preset-env": "^7.19.3",
    "@babel/preset-typescript": "^7.28.5",
    "@rollup/plugin-babel": "^5.3.1",
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-eslint": "^8.0.2",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "abab": "^2.0.6",
    "eslint": "^8.24.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0",
    "jest": "^29.1.2",
    "peggy": "^3.0.2",
    "rollup": "^2.79.1",
    "rollup-plugin-banner": "^0.2.1",
    "rollup-plugin-terser": "^7.0.2",
    "tslib": "^2.8.1",
    "typescript": "^4.8.4",
    "vuepress-jsdoc": "^5.0.0"
  },
  "dependencies": {
    "mathjs": "^14.2.0",
    "random-js": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0"
  },
  "scripts": {
    "build": "npm run build:dev && npm run build:prod && npm run build:declaration",
    "build:prepare": "npm run build:grammars && npm run lint",
    "build:declaration": "node ./scripts/build-declarations.cjs",
    "build:dev": "npm run build:prepare && rollup --c --environment BUILD:dev",
    "build:grammars": "peggy -c ./peggy.config.cjs ./src/parser/grammars/grammar.pegjs",
    "build:prod": "npm run build:prepare && rollup --c --environment BUILD:prod",
    "docs:build": "vuepress-jsdoc --dist ./docs --folder api --exclude=\"index.js,**/index.js,**/parser/grammars/*\" --partials=\"./docs/partials/**/*.hbs\" --readme=\"./docs/readme.md\"",
    "docs:watch": "npm run docs:build -- --watch",
    "watch": "npm run build:dev -- -w",
    "lint": "eslint \"src/**/*.{js,ts}\" \"tests/**/*.{js,ts}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,ts}\" \"tests/**/*.{js,ts}\"",
    "pretest": "npm run build:prepare",
    "test": "jest",
    "test:coverage": "npm test -- --coverage",
    "test:watch": "npm test -- --watchAll",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run build"
  }
}