{
  "extends": "./tsconfig.json",
  "include": [
    "src/index.ts",
    "src/v3/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "tests",
    "dist",
    "node_modules"
  ],
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "sourceMap": false
  }
}
